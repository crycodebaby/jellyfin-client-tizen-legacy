    "prepare:tizen": "node scripts/prepare-runtime.cjs",
    "screenshot": "node scripts/capture-preview.cjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "acorn": "8.19.0",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
