{
  "name": "smairys-mediathek",
  "version": "0.1.0",
  "private": true,
  "description": "Entwicklung und Prüfungen für die Tizen-TV-Vorschau",
  "scripts": {
    "check": "node scripts/check-project.cjs",
    "check:public": "node scripts/check-public-history.cjs",
    "preview": "node scripts/preview.cjs",
    "test:ui": "node --test tests/ui.test.cjs",
